---
import "@fontsource/archivo/500.css";
import "@fontsource/archivo/700.css";
import "@fontsource/archivo/800.css";
import "@fontsource/archivo/900.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import { url } from "../lib/url.js";
const { title = "TL;DRSS", description = "Engineering blogs from top tech companies — summarized and categorized. We read the feeds so you don't have to." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FCFCFA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#060606" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={url("/favicon-32.png")} />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("tldrss-theme");
          var theme = stored || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="nav__inner">
        <a href={url("/")} class="logo">tl;drss<span class="cursor" aria-hidden="true"></span></a>
        <nav class="nav__links" aria-label="Main">
          <a href={url("/")}>Latest</a>
          <a href={url("/categories/")}>Categories</a>
          <a href={url("/sources/")}>Sources</a>
        </nav>
        <button class="toggle" id="theme-toggle" aria-label="Toggle color theme">
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <p class="mono foot-cmd"><span class="hl">$</span> while true; do read_feeds | summarize; sleep 6h; done</p>
        <p class="foot-note">
          Summaries are written by an LLM in this site's own words; every post links to the
          original article, which remains the canonical source.
        </p>
      </div>
    </footer>
    <script is:inline>
      document.getElementById("theme-toggle").addEventListener("click", function () {
        var next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", next);
        try { localStorage.setItem("tldrss-theme", next); } catch (e) {}
      });
    </script>
  </body>
</html>

<style is:global>
  /* ── reset ─────────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; }
  * { margin: 0; padding: 0; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  img, svg { display: block; max-width: 100%; }
  button, input, a { font: inherit; color: inherit; }
  button { background: none; border: none; cursor: pointer; }
  a { text-decoration: none; }
  ul { list-style: none; }

  /* ── tokens ────────────────────────────────────────────── */
  :root {
    --bg:            #fcfcfa;
    --ink:           #0a0a0a;
    --muted:         #55554f;
    --faint:         #8a8a84;
    --hairline:      rgba(10, 10, 10, 0.14);
    --hairline-soft: rgba(10, 10, 10, 0.08);
    --hairline-bold: rgba(10, 10, 10, 0.32);
    --accent:        #0047ff;
    --accent-ink:    #fcfcfa;
    --accent-wash:   rgba(0, 71, 255, 0.08);
    --surface:       #f3f3ef;
    --nav-bg:        rgba(252, 252, 250, 0.78);

    --pad-x: clamp(1.25rem, 5vw, 6rem);
    --maxw: 1440px;

    --f-display: "Archivo", system-ui, sans-serif;
    --f-body: "Inter", system-ui, sans-serif;
    --f-mono: "JetBrains Mono", ui-monospace, monospace;

    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-theme="dark"] {
    --bg:            #060606;
    --ink:           #f5f5f2;
    --muted:         #9c9c96;
    --faint:         #6a6a64;
    --hairline:      rgba(245, 245, 242, 0.15);
    --hairline-soft: rgba(245, 245, 242, 0.08);
    --hairline-bold: rgba(245, 245, 242, 0.34);
    --accent:        #4d7cff;
    --accent-ink:    #060606;
    --accent-wash:   rgba(77, 124, 255, 0.12);
    --surface:       #101010;
    --nav-bg:        rgba(6, 6, 6, 0.72);
  }

  html, body { overflow-x: hidden; }
  body {
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--f-body);
    font-size: 1rem;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    transition: background-color 0.5s var(--ease), color 0.5s var(--ease);
  }
  ::selection { background: var(--accent); color: var(--accent-ink); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 1px; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition: none !important; animation: none !important; }
  }

  .wrap { max-width: var(--maxw); margin-inline: auto; padding-inline: var(--pad-x); }
  .mono {
    font-family: var(--f-mono); font-size: 0.6875rem;
    letter-spacing: 0.22em; text-transform: uppercase; font-weight: 500;
  }
  .hl { color: var(--accent); font-style: normal; }

  .skip {
    position: absolute; left: 0; top: -60px; z-index: 200;
    background: var(--accent); color: var(--accent-ink);
    padding: 0.7rem 1.2rem;
    font-family: var(--f-mono); font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
    transition: top 0.2s var(--ease);
  }
  .skip:focus { top: 0; }

  /* ── nav ───────────────────────────────────────────────── */
  .nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--nav-bg);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--hairline);
  }
  .nav__inner {
    max-width: var(--maxw); margin-inline: auto; padding-inline: var(--pad-x);
    height: 74px; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
  }
  .logo {
    font-family: var(--f-display); font-weight: 900; font-size: 1.35rem;
    letter-spacing: -0.02em; text-transform: lowercase;
    display: inline-flex; align-items: center;
  }
  .logo .cursor {
    display: inline-block; width: 0.5em; height: 1.05em; margin-left: 0.08em;
    background: var(--accent); transform: translateY(0.14em);
    animation: blink 1.15s steps(1) infinite;
  }
  @keyframes blink { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  .nav__links { display: flex; align-items: center; gap: clamp(1rem, 2.4vw, 2.4rem); }
  .nav__links a {
    font-family: var(--f-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted); position: relative; padding: 0.4rem 0;
    transition: color 0.25s var(--ease);
  }
  .nav__links a::after {
    content: ""; position: absolute; left: 0; bottom: 0; height: 1px; width: 100%;
    background: var(--accent); transform: scaleX(0); transform-origin: right;
    transition: transform 0.35s var(--ease);
  }
  .nav__links a:hover { color: var(--ink); }
  .nav__links a:hover::after { transform: scaleX(1); transform-origin: left; }

  .toggle {
    position: relative; width: 40px; height: 40px; border-radius: 50%; flex: none;
    display: inline-grid; place-items: center;
    border: 1px solid var(--hairline); color: var(--ink);
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .toggle:hover { border-color: var(--hairline-bold); background: var(--accent-wash); }
  .toggle svg { position: absolute; width: 18px; height: 18px; transition: opacity 0.4s var(--ease), transform 0.5s var(--ease); }
  .toggle .i-sun { opacity: 0; transform: rotate(-90deg) scale(0.4); }
  .toggle .i-moon { opacity: 1; transform: rotate(0) scale(1); }
  [data-theme="dark"] .toggle .i-sun { opacity: 1; transform: rotate(0) scale(1); }
  [data-theme="dark"] .toggle .i-moon { opacity: 0; transform: rotate(90deg) scale(0.4); }

  /* ── hero / mastheads ──────────────────────────────────── */
  main { padding-top: clamp(3.5rem, 9vh, 6.5rem); padding-bottom: clamp(4rem, 10vh, 7rem); }
  .eyebrow {
    font-family: var(--f-mono); font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.24em; text-transform: uppercase; color: var(--accent);
    display: inline-flex; align-items: center; gap: 0.9em;
    margin-bottom: clamp(1.4rem, 3.5vw, 2.2rem);
  }
  .eyebrow .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); display: inline-block; }
  .hero h1, .page-head h1 {
    font-family: var(--f-display); font-weight: 900; text-transform: uppercase;
    font-size: clamp(2.6rem, 8.5vw, 7.4rem); line-height: 0.92; letter-spacing: -0.035em;
    max-width: 16ch; margin-bottom: clamp(1.6rem, 3.5vw, 2.4rem); text-wrap: balance;
  }
  .hero h1 .ln { display: block; overflow: hidden; }
  .hero h1 .ln > span { display: block; transform: translateY(105%); animation: rise 0.95s var(--ease) forwards; }
  .hero h1 .ln:nth-child(1) > span { animation-delay: 0.08s; }
  .hero h1 .ln:nth-child(2) > span { animation-delay: 0.18s; }
  .hero h1 .ln:nth-child(3) > span { animation-delay: 0.28s; }
  @keyframes rise { to { transform: translateY(0); } }
  .hero__sub {
    font-size: clamp(1rem, 1.5vw, 1.3rem); color: var(--muted); max-width: 54ch;
    opacity: 0; animation: fade 0.9s var(--ease) 0.5s forwards;
  }
  @keyframes fade { to { opacity: 1; } }
  .hero { padding-bottom: clamp(2.5rem, 6vw, 4.5rem); }
  .page-head { margin-bottom: clamp(2rem, 5vw, 3.6rem); }
  .page-head h1 { font-size: clamp(2.4rem, 7vw, 5.6rem); }
  .page-intro { color: var(--muted); max-width: 58ch; font-size: clamp(1rem, 1.4vw, 1.2rem); }

  /* ── marquee ───────────────────────────────────────────── */
  .marquee {
    border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline);
    padding: clamp(1rem, 2.4vw, 1.7rem) 0; margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
    overflow: hidden; white-space: nowrap;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .marquee__track { display: inline-flex; will-change: transform; animation: slide 40s linear infinite; }
  .marquee__track span {
    font-family: var(--f-display); font-weight: 900; text-transform: uppercase;
    font-size: clamp(1.2rem, 2.8vw, 2.2rem); letter-spacing: -0.02em;
    display: inline-flex; align-items: center;
  }
  .mq-star { color: var(--accent); padding: 0 clamp(0.7rem, 1.6vw, 1.3rem); font-size: 0.7em; }
  @keyframes slide { to { transform: translateX(-50%); } }

  /* ── section header ────────────────────────────────────── */
  .sh { margin-bottom: clamp(1.6rem, 4vw, 2.6rem); }
  .sh__label {
    font-family: var(--f-mono); font-size: 0.6875rem; font-weight: 500;
    letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted);
    display: flex; align-items: baseline; gap: 0.9em; padding-bottom: 1.1rem;
  }
  .sh__num { color: var(--accent); }
  .sh__line { height: 1px; background: var(--hairline-bold); }

  /* ── filter bar ────────────────────────────────────────── */
  .filterbar {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    margin-bottom: clamp(1.4rem, 3vw, 2.2rem);
  }
  .filterbar__btn {
    font-family: var(--f-mono); font-size: 0.66rem; font-weight: 500;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--muted); border: 1px solid var(--hairline);
    padding: 0.55em 0.95em;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .filterbar__btn:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-wash); }
  .filterbar__btn.is-active { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }

  /* ── post rows ─────────────────────────────────────────── */
  .row {
    display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: clamp(1rem, 3vw, 3.5rem); align-items: start;
    padding: clamp(1.8rem, 3.5vw, 2.8rem) 0;
    border-top: 1px solid var(--hairline);
  }
  .row:last-of-type { border-bottom: 1px solid var(--hairline); }
  .row__idx {
    font-family: var(--f-display); font-weight: 900;
    font-size: clamp(1.7rem, 3.4vw, 2.9rem); line-height: 1; letter-spacing: -0.04em;
    color: transparent; -webkit-text-stroke: 1px var(--hairline-bold);
    padding-top: 0.25rem;
    transition: color 0.4s var(--ease), -webkit-text-stroke-color 0.4s var(--ease);
  }
  .row:hover .row__idx { color: var(--accent); -webkit-text-stroke-color: var(--accent); }
  .row__cat {
    font-family: var(--f-mono); font-size: 0.66rem; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .row__title {
    font-family: var(--f-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(1.35rem, 2.8vw, 2.4rem); letter-spacing: -0.025em; line-height: 1.05;
    margin-bottom: 0.75rem; transition: transform 0.4s var(--ease); text-wrap: balance;
  }
  .row:hover .row__title { transform: translateX(6px); }
  .row__title a:hover { color: var(--accent); }
  .row__title .arw { color: var(--faint); font-size: 0.6em; font-family: var(--f-mono); vertical-align: 0.35em; }
  .row__desc { color: var(--muted); font-size: clamp(0.96rem, 1.25vw, 1.08rem); line-height: 1.55; max-width: 68ch; }
  .row__tags { margin-top: 1.05rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .row__tags a {
    font-family: var(--f-mono); font-size: 0.625rem; font-weight: 500;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--muted); border: 1px solid var(--hairline); padding: 0.4em 0.75em;
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .row__tags a:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-wash); }
  .row__side { text-align: right; min-width: max-content; }
  .row__src {
    display: block;
    font-family: var(--f-display); font-weight: 900; text-transform: uppercase;
    font-size: clamp(1.15rem, 2.2vw, 1.9rem); letter-spacing: -0.03em; line-height: 1;
    transition: color 0.3s var(--ease);
  }
  .row__src:hover { color: var(--accent); }
  .row__date {
    display: block; margin-top: 0.55rem;
    font-family: var(--f-mono); font-size: 0.6rem; font-weight: 500;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--faint);
  }

  /* ── index rows (categories) & stat grid (sources) ─────── */
  .cap-row {
    display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: clamp(1rem, 3vw, 3rem); align-items: center;
    padding: clamp(1.6rem, 3vw, 2.4rem) 0;
    border-top: 1px solid var(--hairline);
  }
  .cap-row:last-of-type { border-bottom: 1px solid var(--hairline); }
  .cap-row__idx { font-family: var(--f-mono); font-size: 0.75rem; letter-spacing: 0.12em; color: var(--faint); transition: color 0.3s var(--ease); }
  .cap-row:hover .cap-row__idx { color: var(--accent); }
  .cap-row__title {
    font-family: var(--f-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(1.3rem, 2.6vw, 2.2rem); letter-spacing: -0.025em; line-height: 1.05;
    transition: transform 0.4s var(--ease);
  }
  .cap-row:hover .cap-row__title { transform: translateX(6px); }
  .cap-row:hover .cap-row__title a { color: var(--accent); }
  .cap-row__desc { color: var(--muted); font-size: 0.95rem; margin-top: 0.45rem; max-width: 56ch; }
  .cap-row__stat { text-align: right; }
  .cap-row__num {
    font-family: var(--f-display); font-weight: 900;
    font-size: clamp(1.5rem, 2.8vw, 2.4rem); letter-spacing: -0.03em; color: var(--accent); line-height: 1;
  }
  .cap-row__slabel { font-family: var(--f-mono); font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--faint); margin-top: 0.45rem; }

  .stat-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
    border-top: 1px solid var(--hairline); border-left: 1px solid var(--hairline);
  }
  .stat-cell {
    display: block; padding: clamp(1.4rem, 3vw, 2.2rem) clamp(1.1rem, 2vw, 1.6rem);
    border-right: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline);
    transition: background-color 0.3s var(--ease);
  }
  .stat-cell:hover { background: var(--accent-wash); }
  .stat-cell__name {
    font-family: var(--f-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(1.15rem, 2vw, 1.6rem); letter-spacing: -0.025em; line-height: 1.05;
  }
  .stat-cell:hover .stat-cell__name { color: var(--accent); }
  .stat-cell__count { font-family: var(--f-mono); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--faint); margin-top: 0.55rem; }

  /* ── misc ──────────────────────────────────────────────── */
  .pagination { display: flex; justify-content: space-between; margin-top: clamp(2rem, 5vw, 3.2rem); }
  .pagination a {
    display: inline-flex; align-items: center; gap: 0.6em;
    font-family: var(--f-mono); font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase;
    padding: 0.85rem 1.4rem; border: 1px solid var(--ink); color: var(--ink);
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .pagination a:hover { background: var(--ink); color: var(--bg); }
  .empty { color: var(--muted); font-family: var(--f-mono); font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 2rem 0; }

  footer { border-top: 1px solid var(--hairline); padding: clamp(1.6rem, 4vw, 2.6rem) 0 clamp(2.2rem, 5vw, 3.2rem); }
  .foot-cmd { color: var(--faint); margin-bottom: 0.9rem; letter-spacing: 0.08em; text-transform: none; }
  .foot-note { color: var(--muted); font-size: 0.86rem; max-width: 68ch; }

  @media (max-width: 720px) {
    .row, .cap-row { grid-template-columns: 1fr; gap: 0.7rem; }
    .row__idx { display: none; }
    .cap-row__idx { display: none; }
    .row__side, .cap-row__stat { text-align: left; display: flex; align-items: baseline; gap: 1rem; }
    .row__date, .cap-row__slabel { margin-top: 0; }
    .nav__links { gap: 0.9rem; }
    .nav__links a { font-size: 0.64rem; }
    .logo { font-size: 1.15rem; }
  }
</style>
