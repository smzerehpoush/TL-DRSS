---
import Base from "../../layouts/Base.astro";
import { taxonomy, postsByCategory } from "../../lib/data.js";
import { url } from "../../lib/url.js";

const rows = taxonomy
  .map((c) => ({ ...c, count: postsByCategory(c.slug).length }))
  .sort((a, b) => b.count - a.count);
---
<Base title="Categories · TL;DRSS">
  <div class="page-head">
    <p class="eyebrow"><span class="dot"></span> taxonomy</p>
    <h1>Categories</h1>
    <p class="page-intro">One shared vocabulary imposed on every blog — thirteen fixed categories, no tag soup.</p>
  </div>
  {rows.map((c, i) => (
    <div class="cap-row">
      <span class="cap-row__idx">{String(i + 1).padStart(2, "0")}</span>
      <div>
        <h2 class="cap-row__title"><a href={url(`/category/${c.slug}/`)}>{c.name}</a></h2>
        <p class="cap-row__desc">{c.description}</p>
      </div>
      <div class="cap-row__stat">
        <div class="cap-row__num">{c.count}</div>
        <div class="cap-row__slabel">posts</div>
      </div>
    </div>
  ))}
</Base>
