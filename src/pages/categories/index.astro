---
import Base from "../../layouts/Base.astro";
import { taxonomy, postsByCategory } from "../../lib/data.js";
import { url } from "../../lib/url.js";

const rows = taxonomy
  .map((c) => ({ ...c, count: postsByCategory(c.slug).length }))
  .sort((a, b) => b.count - a.count);
---
<Base title="Categories · Tech Blogs">
  <h1>Categories</h1>
  <p class="page-intro">One shared vocabulary across every blog.</p>
  <ul class="index-list">
    {rows.map((c) => (
      <li>
        <a href={url(`/category/${c.slug}/`)}>{c.name}</a>
        <span class="count">{c.count} posts</span>
      </li>
    ))}
  </ul>
</Base>
