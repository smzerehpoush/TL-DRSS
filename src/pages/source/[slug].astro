---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { postsBySource } from "../../lib/data.js";

export async function getStaticPaths() {
  const { sources } = await import("../../lib/data.js");
  return sources.map((s) => ({ params: { slug: s.slug }, props: { source: s } }));
}

const { source } = Astro.props;
const list = postsBySource(source.slug);
---
<Base title={`${source.name} · TL;DRSS`}>
  <div class="page-head">
    <p class="eyebrow"><span class="dot"></span> source · {list.length} posts</p>
    <h1>{source.name}</h1>
    <p class="page-intro">Summarized engineering posts from {source.name}.</p>
  </div>
  {list.length === 0 && <p class="empty">Nothing here yet.</p>}
  {list.map((post, i) => <PostCard post={post} index={i + 1} />)}
</Base>
