---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { postsByCategory } from "../../lib/data.js";

export async function getStaticPaths() {
  const { taxonomy } = await import("../../lib/data.js");
  return taxonomy.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const list = postsByCategory(category.slug);
---
<Base title={`${category.name} · TL;DRSS`}>
  <div class="page-head">
    <p class="eyebrow"><span class="dot"></span> category · {list.length} posts</p>
    <h1>{category.name}</h1>
    <p class="page-intro">{category.description}</p>
  </div>
  {list.length === 0 && <p class="empty">Nothing here yet.</p>}
  {list.map((post, i) => <PostCard post={post} index={i + 1} />)}
</Base>
