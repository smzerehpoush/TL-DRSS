---
import Base from "../../layouts/Base.astro";
import { sources, postsBySource } from "../../lib/data.js";
import { url } from "../../lib/url.js";

const rows = sources
  .map((s) => ({ ...s, count: postsBySource(s.slug).length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---
<Base title="Sources · Tech Blogs">
  <h1>Sources</h1>
  <p class="page-intro">Hand-picked engineering blogs from top tech companies.</p>
  <ul class="index-list">
    {rows.map((s) => (
      <li>
        <a href={url(`/source/${s.slug}/`)}>{s.name}</a>
        <span class="count">{s.count} posts</span>
      </li>
    ))}
  </ul>
</Base>
