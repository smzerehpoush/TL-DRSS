---
import Base from "../../layouts/Base.astro";
import { sources, postsBySource } from "../../lib/data.js";
import { url } from "../../lib/url.js";

const rows = sources
  .map((s) => ({ ...s, count: postsBySource(s.slug).length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---
<Base title="Sources · TL;DRSS">
  <div class="page-head">
    <p class="eyebrow"><span class="dot"></span> the roster</p>
    <h1>Sources</h1>
    <p class="page-intro">Hand-picked engineering blogs from top tech companies. A blog without a working feed doesn't make the list.</p>
  </div>
  <div class="stat-grid">
    {rows.map((s) => (
      <a class="stat-cell" href={url(`/source/${s.slug}/`)}>
        <div class="stat-cell__name">{s.name}</div>
        <div class="stat-cell__count">{s.count} posts</div>
      </a>
    ))}
  </div>
</Base>
